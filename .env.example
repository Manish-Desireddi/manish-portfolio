# Environment Variables Example File
# Copy this file to .env or .env.local and fill in the actual values.
# DO NOT commit the actual .env file to version control.

# The base URL for the backend API
VITE_API_BASE_URL=http://localhost:8000

# The secret API key used for authenticated requests (e.g., to the AI assistant backend)
BACKEND_API_KEY=secret_api_key_here

# Formspree Key 
VITE_FORMSPREE_ID=secret_api_key_here
